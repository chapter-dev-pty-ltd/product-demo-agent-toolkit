{
  "name": "product-demo-agent-toolkit",
  "version": "0.0.1",
  "description": "A toolkit that lets your agent make demo videos of your real product.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "product-demo": "./dist/cli.mjs"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills",
    "library"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.6.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc",
    "test": "vitest run",
    "lint": "oxlint",
    "format": "prettier --write .",
    "prepare": "tsdown",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "oxlint": "^1.93.0",
    "prettier": "^3.10.1",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "playwright-core": "^1.65.0",
    "zod": "^4.6.7"
  }
}
